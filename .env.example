APP_ENV=development
APP_NAME=SENTINEL-RAG
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/sentinel_rag

REDIS_URL=redis://localhost:6380/0

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

LOG_LEVEL=INFO
